# General UID/GIU and Timezone
TZ=Asia/Hong_Kong
PUID=1000
PGID=1000

# NordVPN/Gluetun Configuration
# Get your NordVPN credentials from https://account.nordvpn.com
NORDVPN_USER=
NORDVPN_PASSWORD=

# VPN Configuration (optional)
# VPN_TYPE options: openvpn or wireguard (default: openvpn)
VPN_TYPE=openvpn

# SERVER_COUNTRIES: Country code or name (e.g., "United States", "United Kingdom", "Canada")
# Leave empty for automatic server selection
SERVER_COUNTRIES=United States

# For WireGuard protocol, you'll need to generate a private key
# Instructions: https://github.com/qdm12/gluetun/wiki/Wireguard
# WIREGUARD_PRIVATE_KEY=
